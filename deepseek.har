            "text": "event: ready\ndata: {\"request_message_id\":1,\"response_message_id\":2,\"model_type\":\"default\"}\n\nevent: update_session\ndata: {\"updated_at\":1780483876.052196}\n\ndata: {\"v\":{\"response\":{\"message_id\":2,\"parent_id\":1,\"model\":\"\",\"role\":\"ASSISTANT\",\"thinking_enabled\":true,\"ban_edit\":false,\"ban_regenerate\":false,\"status\":\"WIP\",\"incomplete_message\":null,\"accumulated_token_usage\":0,\"feedback\":null,\"inserted_at\":1780483876.0425138,\"search_enabled\":true,\"fragments\":[{\"id\":2,\"type\":\"THINK\",\"content\":\"The\",\"elapsed_secs\":null,\"references\":[],\"stage_id\":2}],\"conversation_mode\":\"DEFAULT\",\"has_pending_fragment\":false,\"auto_continue\":false,\"search_triggered\":true}}}\n\ndata: {\"p\":\"response/conversation_mode\",\"v\":\"DEEP_SEARCH\"}\n\ndata: {\"p\":\"response/fragments/-1/content\",\"o\":\"APPEND\",\"v\":\" user\"}\n\ndata: {\"v\":\" wants\"}\n\ndata: {\"v\":\" me\"}\n\ndata: {\"v\":\" to\"}\n\ndata: {\"v\":\" fetch\"}\n\ndata: {\"v\":\" the\"}\n\ndata: {\"v\":\" content\"}\n\ndata: {\"v\":\" from\"}\n\ndata: {\"v\":\" a\"}\n\ndata: {\"v\":\" specific\"}\n\ndata: {\"v\":\" URL\"}\n\ndata: {\"v\":\".\"}\n\ndata: {\"v\":\" I\"}\n\ndata: {\"v\":\"'ll\"}\n\ndata: {\"v\":\" start\"}\n\ndata: {\"v\":\" by\"}\n\ndata: {\"v\":\" trying\"}\n\ndata: {\"v\":\" to\"}\n\ndata: {\"v\":\" open\"}\n\ndata: {\"v\":\" the\"}\n\ndata: {\"v\":\" URL\"}\n\ndata: {\"v\":\" directly\"}\n\ndata: {\"v\":\" to\"}\n\ndata: {\"v\":\" retrieve\"}\n\ndata: {\"v\":\" the\"}\n\ndata: {\"v\":\" content\"}\n\ndata: {\"v\":\".\"}\n\ndata: {\"p\":\"response/fragments/-1/elapsed_secs\",\"o\":\"SET\",\"v\":1.603564352}\n\ndata: {\"p\":\"response/has_pending_fragment\",\"v\":true}\n\ndata: {\"p\":\"response\",\"o\":\"BATCH\",\"v\":[{\"p\":\"fragments\",\"o\":\"APPEND\",\"v\":[{\"id\":3,\"type\":\"TOOL_OPEN\",\"status\":\"WIP\",\"result\":{\"url\":\"https://hermes-agent.nousresearch.com/docs/user-guide/features/kanban\",\"title\":\"\",\"snippet\":\"\",\"cite_index\":null,\"published_at\":null,\"site_icon\":\"https://cdn.deepseek.com/site-icons/nousresearch.com\",\"site_name\":null,\"query_indexes\":[]},\"reference\":null,\"stage_id\":2}]},{\"p\":\"has_pending_fragment\",\"o\":\"SET\",\"v\":false}]}\n\n: \n\ndata: {\"p\":\"response/fragments/-1\",\"v\":[{\"p\":\"status\",\"v\":\"FINISHED\"},{\"p\":\"result\",\"o\":\"BATCH\",\"v\":[{\"p\":\"title\",\"o\":\"APPEND\",\"v\":\"Kanban (Multi-Agent Board) | Hermes Agent\"},{\"p\":\"snippet\",\"v\":\"# Kanban — Multi-Agent Profile Collaboration\\n\\nWant a walkthrough? Read the [Kanban tutorial](https://hermes-agent.nousresearc\"},{\"p\":\"site_icon\",\"o\":\"SET\",\"v\":\"https://cdn.deepseek.com/site-icons/nousresearch.com\"}]}]}\n\ndata: {\"p\":\"response/has_pending_fragment\",\"o\":\"SET\",\"v\":true}\n\ndata: {\"p\":\"response\",\"o\":\"BATCH\",\"v\":[{\"p\":\"fragments\",\"o\":\"APPEND\",\"v\":[{\"id\":4,\"type\":\"THINK\",\"content\":\"The\",\"elapsed_secs\":null,\"references\":[],\"stage_id\":3}]},{\"p\":\"has_pending_fragment\",\"o\":\"SET\",\"v\":false}]}\n\ndata: {\"p\":\"response/fragments/-1/content\",\"o\":\"APPEND\",\"v\":\" page\"}\n\ndata: {\"v\":\" content\"}\n\ndata: {\"v\":\" has\"}\n\ndata: {\"v\":\" loaded\"}\n\ndata: {\"v\":\".\"}\n\ndata: {\"v\":\" I\"}\n\ndata: {\"v\":\" will\"}\n\ndata: {\"v\":\" proceed\"}\n\ndata: {\"v\":\" with\"}\n\ndata: {\"v\":\" the\"}\n\ndata: {\"v\":\" next\"}\n\ndata: {\"v\":\" round\"}\n\ndata: {\"v\":\" of\"}\n\ndata: {\"v\":\" searches\"}\n\ndata: {\"v\":\" to\"}\n\ndata: {\"v\":\" gather\"}\n\ndata: {\"v\":\" information\"}\n\ndata: {\"v\":\" about\"}\n\ndata: {\"v\":\" the\"}\n\ndata: {\"v\":\" Kan\"}\n\ndata: {\"v\":\"ban\"}\n\ndata: {\"v\":\" feature\"}\n\ndata: {\"v\":\".\"}\n\ndata: {\"p\":\"response/fragments/-1/elapsed_secs\",\"o\":\"SET\",\"v\":1.033499401}\n\ndata: {\"p\":\"response/has_pending_fragment\",\"v\":true}\n\ndata: {\"p\":\"response\",\"o\":\"BATCH\",\"v\":[{\"p\":\"fragments\",\"o\":\"APPEND\",\"v\":[{\"id\":5,\"type\":\"TOOL_SEARCH\",\"status\":\"WIP\",\"content\":null,\"queries\":[{\"query\":\"Hermes Agent Kanban board tutorial\"},{\"query\":\"Hermes Agent kanban_show tool\"},{\"query\":\"Hermes Agent kanban_create task\"},{\"query\":\"Hermes Agent kanban SQLite database schema\"},{\"query\":\"Hermes Agent multi-agent collaboration kanban board\"},{\"query\":\"site:github.com nousresearch hermes-agent kanban\"}],\"results\":[],\"stage_id\":3}]},{\"p\":\"has_pending_fragment\",\"o\":\"SET\",\"v\":false}]}\n\ndata: {\"p\":\"response/fragments/-1/results\",\"o\":\"SET\",\"v\":[{\"url\":\"https://github.com/GumbyEnder/hermes-kanban\",\"title\":\"GitHub - GumbyEnder/hermes-kanban: A dedicated Obsidian plugin + Hermes skill that turns Hermes into an autonomous project executor using Kanban boards inside your Obsidian vault. · GitHub\",\"snippet\":\"Turn Hermes into a true project co-pilot that lives inside your Obsidian workspace. Hermes can break any goal into a structured Kanban board, move cards, query state, and run daily standups and weekly reviews — all from inside Obsidian, fully local, fully private.\",\"cite_index\":null,\"published_at\":1777737600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/issues/16102\",\"title\":\"RFC: review the Kanban — multi-profile collaboration board (PR #16100) · Issue #16102 · NousResearch/hermes-agent\",\"snippet\":\"Kanban is a new durable, SQLite-backed task board shared across all Hermes profiles on a host. Tasks carry an assignee (a profile name), optional dependency links, a workspace kind (scratch / worktree / dir:<path>), and an optional tenant namespace.\",\"cite_index\":null,\"published_at\":1777132800.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/Agent-3-7/hermes-agent-mission-control?ref=producthunt\",\"title\":\"GitHub - Agent-3-7/hermes-agent-mission-control at producthunt · GitHub\",\"snippet\":\"Features * **Kanban board** : see every task at a glance: in progress, blocked, in review, done * **Autonomous execution** : describe what you want in chat, walk away; the agent decides how to get it done\",\"cite_index\":null,\"published_at\":1777651200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2579398.html\",\"title\":\"Hermes Agent工作流编排教程\",\"snippet\":\"1、确认系统已安装hermes v0.13.0或更高版本，执行hermes --version验证。 2、检查~/.hermes/kanban.db是否存在，若无则运行hermes kanban init初始化看板数据库。\",\"cite_index\":null,\"published_at\":1780329600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://dev.to/rosgluk/kanban-in-hermes-agent-for-self-hosted-llm-workflows-1ekf#comments\",\"title\":\"Kanban in Hermes Agent for Self Hosted LLM Workflows\",\"snippet\":\"If you are new to this stack, start with the broader Hermes setup and operations guide and the AI Systems pillar for surrounding architecture. ... How Hermes Kanban and the dispatcher work ... - Board - durable SQLite state for tasks, columns, relations, and history.\",\"cite_index\":null,\"published_at\":1778169600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/dev.to\",\"site_name\":\"DEV Community\",\"query_indexes\":[0]},{\"url\":\"https://www.cnblogs.com/itech/p/20229100#commentform\",\"title\":\"Hermes Agent Kanban Swarm 详解：让多个 Agent 像团队一样协作\",\"snippet\":\"Hermes Agent（NousResearch 开源，172K+ Stars）给出了一个工程化的答案：Kanban Task Board。不是概念验证，不是 demo，而是一个 SQLite 驱动的持久化任务看板，让多个 Agent Profile 以 Orchestrator-Worker 模式异步协作，支持任务依赖、熔断保护、实时 Dashboard 和跨进程安全。\",\"cite_index\":null,\"published_at\":1780070400.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/cnblogs.com\",\"site_name\":\"博客园\",\"query_indexes\":[0]},{\"url\":\"https://blog.csdn.net/xiangaichou/article/details/161293660\",\"title\":\"hermes-kanban-安装与操作手册\",\"snippet\":\"Kanban（看板）是 Hermes Agent v0.12.0 引入的多智能体任务编排系统，基于 SQLite 持久化看板，支持任务拆解、角色分派、并行执行与自动状态流转。简单说：一张看板，调度一队 AI，并行干活，状态不丢。\",\"cite_index\":null,\"published_at\":1779292800.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/csdn.net\",\"site_name\":\"CSDN博客\",\"query_indexes\":[0]},{\"url\":\"https://deepwiki.com/NousResearch/hermes-agent/12.2-kanban-cli-and-dashboard\",\"title\":\"Kanban CLI and Dashboard | NousResearch/hermes-agent | DeepWiki\",\"snippet\":\"The Hermes Kanban system provides a durable, SQLite-backed task board designed for multi-agent coordination and project management. ... and the dispatcher lifecycle. ... The Kanban Dashboard is implemented as a plugin for the Hermes Web UI. It provides a React-based visual interface for task management and real-time monitoring.\",\"cite_index\":null,\"published_at\":1779552000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/deepwiki.com\",\"site_name\":\"DeepWiki\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2520785.html\",\"title\":\"Hermes Agent如何实现自动化团队协作\",\"snippet\":\"1、在 Hermes Agent 配置目录中启用 Kanban 模块：编辑 config.yaml，设置 kanban.enabled: true。 2、指定任务存储后端：配置 kanban.storage.type: \\\"filesystem\\\" 或 \\\"sqlite\\\"，确保任务状态跨重启持久化。\",\"cite_index\":null,\"published_at\":1779465600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://m.php.cn/faq/2484360.html\",\"title\":\"Hermes Agent如何构建自动化业务流程\",\"snippet\":\"hermes agent通过kanban看板、插件链、cron调度、soul.md人设和mcp协议五种方式构建可复用、可监控、可扩展的自动化流程：任务拆解分派、原子操作串联、定时闭环执行、声明式行为定制及外部系统集成。\",\"cite_index\":null,\"published_at\":1778774400.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/blob/main/website/docs/reference/tools-reference.md\",\"title\":\"hermes-agent/website/docs/reference/tools-reference.md at main · NousResearch/hermes-agent\",\"snippet\":\"This page documents Hermes' built-in tools, grouped by toolset. Availability varies by platform, credentials, and enabled toolsets. Quick counts (current registry) ... 7 kanban tools (registered when the kanban dispatcher spawns the agent), 2 Discord tools, and a handful of standalone tools (memory...\",\"cite_index\":null,\"published_at\":1753113600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/linke-ai/hermes-agent-team\",\"title\":\"GitHub - linke-ai/hermes-agent-team: 基于 Hermes Agent 构建的本地多 Agent 团队协作 Web 系统 · GitHub\",\"snippet\":\"基于 Hermes Agent profile 机制构建的多 Agent 协作 Web 系统。每个 Agent 是一个独立的 Hermes profile，拥有独立的人设、技能、记忆与工具，通过 Web 中枢、MCP、ACP 与 Hermes Kanban 完成任务拆解、分派、执行、审查与汇总。\",\"cite_index\":null,\"published_at\":1779206400.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://huntscreens.com/zh/products/minions\",\"title\":\"Hermes Agent任务控制看板：Minions项目管理工具\",\"snippet\":\"Agent的任务控制看板，支持Kanban视图、自主执行 ... Minions 是 Hermes Agent 的任务控制面板，提供一站式任务创建、监督与审查功能。它解决了多终端会话管理混乱、任务状态不透明等痛点，适合需要高效管理多个自主代理任务的用户。\",\"cite_index\":null,\"published_at\":null,\"site_icon\":\"https://cdn.deepseek.com/site-icons/huntscreens.com\",\"site_name\":\"HuntScreens\",\"query_indexes\":[0]},{\"url\":\"https://post.smzdm.com/p/aqr57292/\",\"title\":\"Hermes Agent 推出 Kanban 多 agent 调度_服务软件_什么值得买\",\"snippet\":\"Kanban 调度系统定义了 6 种核心任务状态，构建了完整的工作流生命周期。系统包含 task、run、assignee、dispatcher、tenant 5 个核心对象，并确保 Dashboard、CLI、worker tools 三个界面共享同一份 SQLite 数据源，实现数据一致性。\",\"cite_index\":null,\"published_at\":1778083200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/smzdm.com\",\"site_name\":\"什么值得买\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/profiles.md\",\"title\":\"hermes-agent/website/docs/user-guide/profiles.md at main · NousResearch/hermes-agent\",\"snippet\":\"If you plan to use this profile as a kanban worker (or want the kanban orchestrator to route work to it), pass--description \\\"<role>\\\" at create time so the orchestrator knows what it's good at ... withhermes profile describe — see the Kanban guide for the full routing model.\",\"cite_index\":null,\"published_at\":1753113600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/releases/tag/v2026.5.7?utm_source=www.theneurondaily.com&utm_medium=referral&utm_campaign=hermes-is-eating-openclaw-s-lunch\",\"title\":\"Release Hermes Agent v0.13.0 (2026.5.7) — The Tenacity Release · NousResearch/hermes-agent\",\"snippet\":\"The Tenacity Release — Hermes Agent now finishes what it starts. Kanban ships as a durable multi-agent board (heartbeat, reclaim, zombie detection, auto-block on incomplete exit, per-task retries, hallucination recovery). ... pick them up, hand off...\",\"cite_index\":null,\"published_at\":1778083200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://www.scensmart.com/news/hermes-agent-v2026-5-7-v0-13-0-update-document-list/\",\"title\":\"Hermes Agent v2026.5.7 (v0.13.0) 更新文档一览\",\"snippet\":\"2.1 持久化多智能体Kanban看板 ... - 多项目支持：单实例可部署多个看板，支持任务分发、多Hermes Worker自动认领、任务交接与完结全流程。 - 可靠性保障...\",\"cite_index\":null,\"published_at\":1778169600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/scensmart.com\",\"site_name\":\"ScenSmart一站式智能制造平台|OEM|ODM|行业方案\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2527109.html\",\"title\":\"Hermes Agent如何实现智能调度\",\"snippet\":\"1、使用 hermes kanban_create 命令创建初始任务，并指定目标 profile（如 researcher）与输入参数。 2、任务写入 ~/.hermes/kanban.db 后自动进入 todo 状态。 3、Dispatcher 进程每 60 秒扫描数据库，将满足前置条件的任务状态更新为 ready。\",\"cite_index\":null,\"published_at\":1779552000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2507921.html\",\"title\":\"Hermes Agent如何实现智能流程编排\",\"snippet\":\"1、执行hermes kanban create命令创建新任务，系统自动生成唯一ID并写入~/.hermes/kanban.db。 2、任务初始状态设为todo，经Orchestrator解析后转为ready，等待Dispatcher调度。\",\"cite_index\":null,\"published_at\":1779292800.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2533945.html\",\"title\":\"Hermes Agent如何实现智能任务管理\",\"snippet\":\"1、在终端中运行命令 hermes kanban create \\\"需求分析与脚本生成\\\"，创建一个父级任务。 2、调用 hermes kanban add-subtask --parent-id [ID] --agent researcher --desc \\\"检索Chrome与Edge最新WebDriver兼容性文档\\\" 添加首个子任务。\",\"cite_index\":null,\"published_at\":1779638400.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://segmentfault.com/a/1190000047764569#comment-area\",\"title\":\"Kanban - 多 Agent 协作设计模式\",\"snippet\":\"在 hermes 中，输出以下提示语： 用 kanban 方法，生成 agent 任务，并写入依赖关系： - 任务1: 历史调查 - 调查 Mr. Bean 电视节目的历史和风格，以 markdown 格式写入 `mr-bean-history.md` 文件\",\"cite_index\":null,\"published_at\":1778601600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/segmentfault.com\",\"site_name\":\"SegmentFault 思否\",\"query_indexes\":[0]},{\"url\":\"https://m.php.cn/faq/2484465.html\",\"title\":\"Hermes Agent如何实现复杂流程管理\",\"snippet\":\"该方法通过 Hermes-Kanban 插件构建基于看板（Kanban）的流程状态机，支持任务创建、分配、并行执行、阻塞检测与人工介入，适用于需人工审核或外部系统回调的混合型流程。\",\"cite_index\":null,\"published_at\":1778774400.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://deepwiki.com/NousResearch/hermes-agent/12.1-kanban-core-and-database\",\"title\":\"Kanban Core and Database | NousResearch/hermes-agent | DeepWiki\",\"snippet\":\"The core of the Kanban system is thekanban_db layer, which manages the SQLite database located by default at ~/.hermes/kanban.db hermes_cli/kanban_db.py1-9 This database serves as the shared coordination primitive across all Hermes profiles.\",\"cite_index\":null,\"published_at\":1779552000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/deepwiki.com\",\"site_name\":\"DeepWiki\",\"query_indexes\":[0]},{\"url\":\"https://deepwiki.com/NousResearch/hermes-agent/12-glossary\",\"title\":\"Kanban Task Board | NousResearch/hermes-agent | DeepWiki\",\"snippet\":\"The system is built on a shared SQLite database ... init_db | hermes_cli/kanban_db.py27-28 | Initializes the SQLite schema, tables, and WAL mode for a given board. ... hermes_cli/kanban_db.py95-96 | Core logic for scanning ready tasks, claiming them, and spawning worker profiles.\",\"cite_index\":null,\"published_at\":1779552000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/deepwiki.com\",\"site_name\":\"DeepWiki\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2477741.html\",\"title\":\"Hermes Agent如何搭建多Agent系统\",\"snippet\":\"Kanban 是 Hermes 实现多Agent协作的底层运行时架构，依赖 SQLite 持久化队列与 Dispatcher 调度器协同工作，确保任务可恢复、可追溯、可干预。 1、确认 Hermes 已安装并升级至支持 Kanban 的版本（v0.8.0 及以上）。\",\"cite_index\":null,\"published_at\":1778688000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2478802.html\",\"title\":\"Hermes Agent如何管理复杂工作流\",\"snippet\":\"Hermes Kanban看板系统通过SQLite持久化任务队列与角色化智能体分派，将大任务拆解为可追踪、可恢复、可并行的子任务卡片，实现多角色协作、崩溃恢复、人工干预及并行加速。\",\"cite_index\":null,\"published_at\":1778688000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://www.php.cn/faq/2500190.html\",\"title\":\"Hermes Agent如何实现智能助手工作流\",\"snippet\":\"Kanban 机制将单一任务自动拆解为子任务，并分发给不同 Profile 角色的 Agent 并行执行，实现真正意义上的工作流闭环。 1、使用 hermes profile create researcher 创建调研角色，再安装技能：hermes -p researcher skills install web-search\",\"cite_index\":null,\"published_at\":1779206400.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/php.cn\",\"site_name\":\"php.cn\",\"query_indexes\":[0]},{\"url\":\"https://newreleases.io/project/github/NousResearch/hermes-agent/release/v2026.5.7\",\"title\":\"NousResearch/hermes-agent v2026.5.7 on GitHub\",\"snippet\":\"The Tenacity Release — Hermes Agent now finishes what it starts. Kanban ships as a durable multi-agent board (heartbeat, reclaim, zombie detection, auto-block on incomplete exit, per-task retries, hallucination recovery).\",\"cite_index\":null,\"published_at\":1778083200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/newreleases.io\",\"site_name\":\"NewReleases.io\",\"query_indexes\":[0]},{\"url\":\"https://github.com/tonbistudio/hermes-multi-agent-workflow\",\"title\":\"GitHub - tonbistudio/hermes-multi-agent-workflow · GitHub\",\"snippet\":\"A reusable skeleton for an **autonomous, multi-agent triage pipeline** built on Hermes: a fleet of agents that **detects** items from sources, **dedups** them ... single Hermes Kanban board. ... → build a fix or make an explainer video), so you can read a complete pipeline and then repoint it at your own domain.\",\"cite_index\":null,\"published_at\":1779984000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://www.kucoin.com/news/flash/hermes-agent-v0-13-0-released-with-revived-kanban-system-and-goal-command\",\"title\":\"Hermes Agent v0.13.0 Released with Revived Kanban System and /goal Command | KuCoin\",\"snippet\":\"Nous Research has launched Hermes Agent v0.13.0 with an enhanced Kanban system for multi-agent collaboration. The update introduces heartbeat detection, zombie process recovery, and a \\\"hallucination recovery\\\" mechanism.\",\"cite_index\":null,\"published_at\":1778169600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/kucoin.com\",\"site_name\":\"KuCoin\",\"query_indexes\":[0]},{\"url\":\"https://developer.baidu.com/article/detail.html?id=7395251\",\"title\":\"多Agent协作场景下Hermes-Agent的实践与优化策略\",\"snippet\":\"为解决上述问题，行业常见技术方案通常采用多Agent协作框架，通过任务看板（Kanban）实现流程可视化与自动化调度。Hermes-Agent作为一款支持多Agent协作的执行框架，其核心价值在于将复杂任务拆解为可并行执行的子任务，并通过统一的Gateway管理任务生命周期。\",\"cite_index\":null,\"published_at\":1780329600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/baidu.com\",\"site_name\":\"百度开发者中心\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/kanban-video-pipeline\",\"title\":\"GitHub - NousResearch/kanban-video-pipeline · GitHub\",\"snippet\":\"Four AI agent profiles collaborate autonomously — a director, cinematographer, renderer, and editor — communicating through structured handoffs, comments, and shared workspace files. ... A **Kanban-driven multi-agent video production pipeline** built on Hermes Agent. You describe a video, the system decomposes it into a task graph, and specialized agent profiles execute each stage...\",\"cite_index\":null,\"published_at\":1777651200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://www.kucoin.com/fr/news/flash/hermes-agent-v0-13-0-released-with-revived-kanban-system-and-goal-command\",\"title\":\"Hermes Agent v0.13.0 publié avec le système Kanban réactivé et la commande /goal | KuCoin\",\"snippet\":\"Nous Research a lancé Hermes Agent v0.13.0 avec un système Kanban révisé pour la collaboration multi-agent. Cette mise à jour ajoute la détection de heartbeat, la récupération des processus zombies et un mécanisme de « récupération d’hallucinations ».\",\"cite_index\":null,\"published_at\":1778169600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/kucoin.com\",\"site_name\":\"KuCoin\",\"query_indexes\":[0]},{\"url\":\"https://www.kucoin.com/fil/news/flash/hermes-agent-v0-13-0-released-with-revived-kanban-system-and-goal-command\",\"title\":\"Lumabas na ang Hermes Agent v0.13.0 kasama ang muling ginawang Kanban System at ang /goal Command | KuCoin\",\"snippet\":\"Lumabas na ni Nous Research ang Hermes Agent v0.13.0 na may bagong sistema ng Kanban para sa multi-agent collaboration. ... Ang pinakamalaking pagbabago ay ang pagbabalik at pagpapabuti ng Kanban system para sa maraming agent na kooperasyon, na dating inalis pagkatapos ng maikling pagsubok.\",\"cite_index\":null,\"published_at\":1778169600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/kucoin.com\",\"site_name\":\"KuCoin\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/pull/21406\",\"title\":\"chore: release v0.13.0 (2026.5.7) by teknium1 · Pull Request #21406 · NousResearch/hermes-agent\",\"snippet\":\"Durable multi-agent Kanban — heartbeat, reclaim, zombie detection, retry budgets, hallucination gate, multi-project boards ... The Tenacity Release — Hermes Agent now finishes what it starts. - Durable multi-agent Kanban with heartbeat, reclaim, zombie detection, retry budgets, hallucination gate\",\"cite_index\":null,\"published_at\":1778083200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/pull/21435\",\"title\":\"feat(kanban): add `specify` — auxiliary LLM fleshes out triage tasks by teknium1 · Pull Request #21435 · NousResearch/hermes-agent\",\"snippet\":\"Adds hermes kanban specify [<id> | --all] — one shot of the auxiliary LLM expands a rough one-liner into a real spec and promotes it out of triage. ... `hermes kanban specify <id>` calls the auxiliary LLM (configured under `auxiliary.triage_specifier`)\",\"cite_index\":null,\"published_at\":1778083200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/nesquena/hermes-webui/issues/1555\",\"title\":\"Issue · nesquena/hermes-webui\",\"snippet\":\"Description Hermes Agent just release a new feature called Hermes Kanban, that would be a great feature to support it on the Hermes WebUI https://hermes-agent.nousresearch.com/docs/user-guide/features/kanban\",\"cite_index\":null,\"published_at\":1777737600.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/pull/28429\",\"title\":\"feat(kanban): route code review through agents by veniceassistantbot-eng · Pull Request #28429 · NousResearch/hermes-agent\",\"snippet\":\"Route Kanban coding-task review through agent policy instead of blocking the human operator for routine technical verification. - Addkanban.code_review config plus HERMES_KANBAN_CODE_REVIEW_* env overrides for board/worker review mode, reviewer profile, permission mode, and human-blocking behavior.\",\"cite_index\":null,\"published_at\":1779120000.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]},{\"url\":\"https://github.com/NousResearch/hermes-agent/pull/21541\",\"title\":\"feat(kanban): add tooltips and docs link across dashboard by teknium1 · Pull Request #21541 · NousResearch/hermes-agent\",\"snippet\":\"Every control in the kanban dashboard now has atitle tooltip, and a ? icon next to the board switcher links to the kanban docs page. ... https://hermes-agent.nousresearch.com/docs/user-guide/features/kanban\",\"cite_index\":null,\"published_at\":1778083200.0,\"site_icon\":\"https://cdn.deepseek.com/site-icons/github.com\",\"site_name\":\"GitHub\",\"query_indexes\":[0]}]}\n\ndata: {\"p\":\"response/fragments/-1/status\",\"v\":\"FINISHED\"}\n\ndata: {\"p\":\"response/has_pending_fragment\",\"v\":true}\n\ndata: {\"p\":\"response\",\"o\":\"BATCH\",\"v\":[{\"p\":\"fragments\",\"o\":\"APPEND\",\"v\":[{\"id\":6,\"type\":\"THINK\",\"content\":\"Now\",\"elapsed_secs\":null,\"references\":[],\"stage_id\":4}]},{\"p\":\"has_pending_fragment\",\"o\":\"SET\",\"v\":false}]}\n\ndata: {\"p\":\"response/fragments/-1/content\",\"o\":\"